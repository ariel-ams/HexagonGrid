{
  "name": "bee-grid",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build:roadmap": "node tools/build-roadmap-viewer.js",
    "themes:surroundings": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/generate-theme-surroundings.ps1",
    "sprites:thorn-alpha": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/remove-connected-sprite-background.ps1 -InputPath assets/thornBeetle.png -OutputPath assets/thornBeetle-alpha.png",
    "sprites:lamp": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/prepare-four-frame-strip.ps1 -InputPath assets/items/source/lamp-cell-imagegen.png -OutputPath assets/items/lamp-cell.png",
    "sprites:core-style": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/prepare-sprite-grid.ps1",
    "roadmap:update": "node tools/update-roadmap-state.js",
    "test:roadmap": "node tools/smoke-roadmap-viewer.js && node tools/smoke-roadmap-browser.js",
    "test": "node tools/smoke-data.js && node tools/smoke-core-art.js && node tools/smoke-roadmap-viewer.js && node tools/smoke-roadmap-browser.js && node tools/smoke-browser.js && node tools/smoke-ui-layout.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@xyflow/react": "^12.11.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.60.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
